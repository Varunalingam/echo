  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
